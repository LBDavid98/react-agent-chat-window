{
  "name": "react-agent-chat-window",
  "version": "0.1.0",
  "description": "An embeddable in-app chat window for React agent UIs: a turn stream, a widget kit and a composer \u2014 deliberately not a transport, a theme, or an opinion about your state library.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./src": "./src/index.ts",
    "./chat.css": "./src/chat.css",
    "./dock.css": "./src/dock.css",
    "./adapters/*.css": "./src/adapters/*.css",
    "./dist/*": "./dist/*"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "lint": "oxlint src",
    "harness": "vite --config harness/vite.config.ts",
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "vite build --config build/vite.config.ts",
    "build:iife": "CAI_FORMAT=iife vite build --config build/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "oxlint": "^0.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "chat",
    "chatbot",
    "ai",
    "agent",
    "llm",
    "chat-ui",
    "streaming",
    "widgets",
    "typescript",
    "embeddable"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBDavid98/react-agent-chat-window.git"
  },
  "homepage": "https://github.com/LBDavid98/react-agent-chat-window#readme",
  "bugs": {
    "url": "https://github.com/LBDavid98/react-agent-chat-window/issues"
  },
  "sideEffects": [
    "*.css"
  ]
}
